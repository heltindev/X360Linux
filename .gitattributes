*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.py text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
# Linux scripts without extensions and XDG entries must keep Unix line endings.
distro/x360os-v6/x360os-session text eol=lf
distro/x360os-v6/x360os-start-gnome text eol=lf
distro/x360os-v6/x360os-input-start text eol=lf
distro/x360os-v6/x360os-toggle text eol=lf
distro/x360os-v6/x360os-install-launcher text eol=lf
distro/x360os-v6/*.rules text eol=lf
distro/x360os-v6/*.desktop text eol=lf
distro/x360os-v6/x360os-doom text eol=lf
distro/x360os-v6/x360os-session-light text eol=lf
distro/x360os-v6/x360os-sound-check text eol=lf

# Native Xbox 360 rootfs scripts must retain Linux line endings
distro/x360os-native/*.sh text eol=lf
distro/x360os-native/init text eol=lf
distro/x360os-native/udhcpc-script text eol=lf
distro/x360os-native/*.c text eol=lf

# X360OS recovery scripts must have Unix LF line endings
distro/x360os-recovery/*.sh text eol=lf
distro/x360os-recovery/x360os-safe-start text eol=lf

# Native line endings for X360OS custom shell scripts and PPC programs
distro/x360os-shell/*.sh text eol=lf
distro/x360os-shell/x360os-session text eol=lf
distro/x360os-shell/x360os-input-start text eol=lf
distro/x360os-shell/x360os-input-diagnose text eol=lf
distro/x360os-shell/*.py text eol=lf
