distro/x360os-v6/x360os-session-light text eol=lf
distro/x360os-v6/x360os-sound-check text eol=lf

# Native Xbox 360 rootfs scripts must retain Linux line endings
distro/x360os-native/*.sh text eol=lf
distro/x360os-native/init text eol=lf
distro/x360os-native/udhcpc-script text eol=lf
distro/x360os-native/*.c text eol=lf

