#KBOOTCONFIG
; X360Linux persistent USB system.
; Automatically starts the verified legacy kernel with persistent storage.
; The XeLL title may flash briefly because it is part of the console firmware.
; USB files only. Does not update NAND or modify the Xbox internal HDD.

default=X360LINUX PERSISTENT
timeout=0

X360LINUX PERSISTENT="uda:/vmlinux boot=casper persistent console=tty0 console=ttyS0,115200n8 video=xenonfb panic=60 maxcpus=3 quiet splash"
