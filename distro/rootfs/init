#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
PATH=/bin:/sbin:/usr/bin:/usr/sbin
export PATH
BB=/bin/busybox
usb=/media/usb
root=/newroot
. /iso-root.sh

recover() {
  $BB echo "X360Linux USB: $*"
  $BB cat /proc/partitions
  $BB dmesg | $BB grep -iE 'usb|ehci|ohci|scsi|FAT-fs|EXT4-fs|ISOFS|overlay|loop' | $BB tail -n 10
  $BB echo "Recovery shell. Photograph the X360Linux USB error above."
  exec $BB cttyhack /bin/sh -i </dev/console >/dev/console 2>&1
}

$BB mount -t proc proc /proc || recover "cannot mount proc"
$BB mount -t sysfs sysfs /sys || recover "cannot mount sysfs"
$BB mount -t devtmpfs devtmpfs /dev || recover "cannot mount devtmpfs"
$BB mkdir -p /dev/pts
$BB mount -t devpts devpts /dev/pts
$BB hostname x360linux
$BB echo "X360Linux v0.3 USB | Looking for Debian (up to 30 seconds)..."

device=
saw_usb=0
saw_fat=0
mount_error=
attempt=0
while [ "$attempt" -lt 30 ] && [ -z "$device" ]; do
  attempt=$((attempt + 1))
  for entry in /sys/class/block/*; do
    # Use the kernel's USB ancestry rather than guessing sdX names.
    path=$($BB readlink -f "$entry") || continue
    case "$path" in */usb[0-9]*/*) ;; *) continue ;; esac
    part=/dev/${entry##*/}
    [ -b "$part" ] || continue
    saw_usb=1
    if ! error=$($BB mount -t vfat -o ro "$part" "$usb" 2>&1); then
      mount_error="$part: $error"
      continue
    fi
    saw_fat=1
    if [ "$($BB cat "$usb/X360Linux/USB-ROOT.ID" 2>/dev/null)" = X360LINUX-USB-ROOT-V1 ] &&
       { [ -s "$usb/X360Linux/X360Linux.iso" ] || [ -s "$usb/X360Linux/system.ext4" ]; }; then
      device=$part
      break
    fi
    $BB umount "$usb" || recover "cannot unmount $part"
  done
  [ -n "$device" ] || $BB sleep 1
done

if [ -z "$device" ]; then
  [ "$saw_usb" -eq 1 ] || recover "USB mass storage did not appear in Linux"
  [ "$saw_fat" -eq 1 ] || recover "USB detected, FAT32 mount failed ($mount_error)"
  recover "FAT32 mounted, but the USB marker or Linux image is missing"
fi

$BB echo "X360Linux USB: Debian image found on $device"
$BB mount -t vfat -o remount,rw,umask=0077 "$device" "$usb" ||
  recover "cannot reopen $device for writes"
if [ -s "$usb/X360Linux/X360Linux.iso" ]; then
  $BB echo "X360Linux USB: starting from X360Linux.iso"
  $BB mount -t tmpfs -o mode=0755 tmpfs /run || recover "cannot prepare /run"
  mount_iso_root "$usb/X360Linux/X360Linux.iso" "$usb/X360Linux/USB-DATA.ext4" /run/x360linux "$root" ||
    recover "cannot start the ISO or USB data image"
elif ! $BB mount -t ext4 -o loop,rw,noatime "$usb/X360Linux/system.ext4" "$root"; then
  recover "cannot mount the legacy Debian system.ext4"
fi
if ! $BB chroot "$root" /bin/sh -c ':' || [ ! -x "$root/sbin/init" ]; then
  recover "Debian files mounted, but its PowerPC shell or init cannot run"
fi

# Keep the backing FAT mount and the live device nodes visible in Debian.
$BB mkdir -p "$root/dev" "$root/proc" "$root/sys" "$root/run" "$root/bootusb"
if [ -s "$usb/X360Linux/X360Linux.iso" ]; then
  $BB mount -o move /run "$root/run" || recover "cannot move the ISO backing mounts into Debian"
fi
$BB mount -o bind "$usb" "$root/bootusb" &&
  $BB mount -o bind /proc "$root/proc" &&
  $BB mount -o bind /sys "$root/sys" &&
  $BB mount -o rbind /dev "$root/dev" ||
  recover "cannot prepare mounts for Debian"

$BB echo "X360Linux USB: starting Debian Ports PowerPC..."
exec $BB switch_root -c /dev/console "$root" /sbin/init
