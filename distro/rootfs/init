#!/bin/sh
# X360Linux minimal initramfs (PowerPC32 BE userspace, PPC64 kernel).
PATH=/bin:/sbin:/usr/bin:/usr/sbin
export PATH
/bin/busybox echo "[#########################---]  90%  Linux user-space started"
/bin/busybox mount -t proc proc /proc
/bin/busybox mount -t sysfs sysfs /sys
/bin/busybox mount -t devtmpfs devtmpfs /dev
/bin/busybox mkdir -p /dev/pts /run
/bin/busybox mount -t devpts devpts /dev/pts
/bin/busybox hostname x360linux
/bin/busybox echo ""
# Check the interactive shell can be launched before declaring the boot ready.
if ! /bin/busybox sh -c ':'; then
    /bin/busybox echo "X360Linux: interactive shell self-test failed."
    exit 1
fi
/bin/busybox echo "[############################] 100%  X360Linux shell ready"
/bin/busybox echo "=================================================="
/bin/busybox echo " X360Linux - early experimental initramfs shell"
/bin/busybox echo " PowerPC32 big-endian userspace / 64-bit Xenon kernel"
/bin/busybox echo "=================================================="
/bin/busybox echo "Linux started successfully on this Xbox 360!"
/bin/busybox echo "No desktop is installed yet. This is a command-line shell."
/bin/busybox echo "Connect a USB keyboard to enter commands."
/bin/busybox echo "Type: uname -a, dmesg, cat /proc/meminfo"
/bin/busybox echo "To reboot: reboot -f"
/bin/busybox echo ""
# /dev/console cannot be a controlling terminal. Use the BusyBox-supported
# cttyhack applet (for PID 1: "exec cttyhack sh"), which detects an active
# real tty on Xenon's framebuffer console before launching the shell.
# Source: https://busybox.net/FAQ.html (job control / can't access tty).
exec /bin/busybox cttyhack /bin/sh -i </dev/console >/dev/console 2>&1
